def number_pattern(n): 
    if not isinstance(n,int): 

#checks if n is int

        return "Argument must be an integer value."
    if not n > 0: 
#checks if n is positive

        return "Argument must be an integer greater than 0."
    result=[] 
#we assigned an empty bucket

    for i in range(1,n+1):
#it repeats until n+1 value, bcz it stars from 0

        result.append(str(i))
#to put each value in the bucket over and over again

        final= " ".join(result) 
#to make spaces in our collection

    return (final)

number_pattern(5)    


def add_setting(dict_settings,tuple_settings):
    key,value=tuple_settings                                                                                   
    key=str(key).lower()
    value=str(value).lower()

    if key in dict_settings:
        return f"Setting '{key.lower()}' already exists! Cannot add a new setting with this name."
    else:
        dict_settings[key]=value
        return f"Setting '{key.lower()}' added with value '{value.lower()}' successfully!"
def update_setting(dict_settings,tuple_settings):
    key,value=tuple_settings
    key=str(key).lower()
    value=str(value).lower()
    if key in dict_settings:
        dict_settings[key]=value
        return f"Setting '{key.lower()}' updated to '{value.lower()}' successfully!"
    else:
        return f"Setting '{key.lower()}' does not exist! Cannot update a non-existing setting."
def delete_setting(dict_settings,key):
     key=str(key).lower()
     if key in dict_settings:
        del dict_settings[key] 
        return f"Setting '{key.lower()}' deleted successfully!"
     else:
        return "Setting not found!"
def view_settings(dict_settings):
    if not dict_settings:
        return "No settings available."

    result='Current User Settings:\n'
    for key,value in dict_settings.items():
        result+= f"{key.capitalize()}: {value}\n"
    return result

class HashTable:
    def __init__(self):
        # Initialize an empty dictionary for the collection
        self.collection = {}

    def hash(self, key: str) -> int:
        """Computes the hash value by summing the Unicode values of each character."""
        return sum(ord(char) for char in key)

    def add(self, key, value):
        """Adds a key-value pair to the hash table, handling collisions with nested dictionaries."""
        hashed_key = self.hash(key)
        
        # If the hash doesn't exist yet in the collection, create an empty nested dictionary
        if hashed_key not in self.collection:
            self.collection[hashed_key] = {}
            
        # Store the key-value pair inside the nested dictionary
        self.collection[hashed_key][key] = value

    def remove(self, key):
        """Removes the key-value pair if it exists; otherwise, does nothing."""
        hashed_key = self.hash(key)
        
        # Check if the hashed key exists in the collection and the specific key is inside the nested dict
        if hashed_key in self.collection and key in self.collection[hashed_key]:
            del self.collection[hashed_key][key]
            
            # Optional cleanup: remove the outer hash entry if the nested dictionary is empty
            if not self.collection[hashed_key]:
                del self.collection[hashed_key]

    def lookup(self, key):
        """Returns the value associated with the key, or None if it does not exist."""
        hashed_key = self.hash(key)
        
        # Check if the hash and key exist, then return the value
        if hashed_key in self.collection and key in self.collection[hashed_key]:
            return self.collection[hashed_key][key]
            
        return None
